# Copy to .env for local runs (export these, or use your host's dashboard). Never commit real values.

PORT=3000
DATA_DIR=./data                 # SQLite lives here. On a host, mount a persistent disk/volume here.

SUPPORT_EMAIL=you@yourdomain.com   # shown on privacy + delete pages (Play Store requires a real contact)
APP_NAME=DreamGift

# --- Online payments (Razorpay). Leave blank to run UPI-direct only. Start with TEST keys. ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string   # same value you enter in Razorpay Dashboard > Webhooks

# route    = each couple has a Razorpay Route linked account; money is split to them automatically (recommended)
# platform = all money lands in YOUR Razorpay account and you pay couples out yourself (read README: compliance)
SETTLEMENT_MODE=route
PLATFORM_FEE_PERCENT=0          # only applies in route mode; e.g. 2 keeps 2% of each gift

# Protects /api/admin/* (attach linked accounts, payout summary). Use a long random string.
ADMIN_KEY=
